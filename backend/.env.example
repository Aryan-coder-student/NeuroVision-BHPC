# Example Environment Variables for NeuroVision Backend
DEBUG=True
SECRET_KEY=django-insecure-change-me
ENCRYPTION_KEY=D7fR1K9WpX8L2Z5V3N6B4M7Q1A9S2D5F8G0H4J7K9L1=

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/neondb

# Multi-tenancy
TENANT_BASE_DOMAIN=localtest.me
SESSION_COOKIE_DOMAIN=.localtest.me
CSRF_COOKIE_DOMAIN=.localtest.me

# Existing inference providers (server-side only)
MONAI_SEGMENTATION_BASE_URL=http://127.0.0.1:5000
# False until Flask implements POST /predict/files multipart NIfTI.
MONAI_SEGMENTATION_UPLOAD_ENABLED=False
MONAI_SEGMENTATION_TIMEOUT_SECONDS=120
MONAI_SEGMENTATION_API_TOKEN=
MONAI_SEGMENTATION_MODEL_VERSION=2.1

BLIP_VQA_BASE_URL=https://pahariaryan121-neurovision-api.hf.space
BLIP_VQA_TIMEOUT_SECONDS=60
BLIP_VQA_API_TOKEN=
BLIP_VQA_MODEL_VERSION=1.0

# Private report image storage: Hugging Face Storage Bucket (server-side only)
# Set to huggingface in Render only after creating scoped S3 credentials.
NEUROVISION_REPORT_STORAGE=filesystem
HUGGINGFACE_S3_NAMESPACE=pahariaryan
HUGGINGFACE_S3_BUCKET=neuro-bucket
# Generate these via Hugging Face Settings > Access Tokens > Generate S3 credentials.
HUGGINGFACE_S3_ACCESS_KEY_ID=
HUGGINGFACE_S3_SECRET_ACCESS_KEY=
